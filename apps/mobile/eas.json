{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_TIRKHA_DEMO_AUTH": "1" },
      "android": { "buildType": "apk" }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": { "EXPO_PUBLIC_TIRKHA_DEMO_AUTH": "0" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
