{
  "expo": {
    "name": "Tirkha",
    "slug": "tirkha",
    "scheme": "tirkha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "653f131b-22cd-49c6-8f2f-d266a38b4ace"
      }
    },
    "owner": "rasikupreti09",
    "updates": {
      "url": "https://u.expo.dev/653f131b-22cd-49c6-8f2f-d266a38b4ace"
    },
    "android": {
      "package": "com.tirkha.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1F2937"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
    },
    "ios": {
      "bundleIdentifier": "com.tirkha.app",
      "supportsTablet": true,
      "buildNumber": "1"
    }
  }
}
