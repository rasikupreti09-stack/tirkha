EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public HTTPS origin of the deployed Next.js server (no trailing path).
EXPO_PUBLIC_API_URL=https://YOUR_TIRKHA_WEB_HOST

# Public EAS project UUID; extra.eas.projectId is preferred when EAS is linked.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Build-time Android Maps SDK key (restrict to your package + signing SHA-1).
# iOS uses Apple Maps; Expo Go supplies its own native map configuration.
GOOGLE_MAPS_ANDROID_API_KEY=
