EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional local/demo mode. This does not bypass phone OTP; configure URL/key for
# the local mock server if you want to verify demo accounts without live SMS.
EXPO_PUBLIC_TIRKHA_LOCAL_MOCK=0

# Public HTTPS origin of the deployed Next.js server (no trailing path).
EXPO_PUBLIC_API_URL=https://YOUR_TIRKHA_WEB_HOST

# Public EAS project UUID, set in the matching EAS environment for builds.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Store identifiers are permanent once published. Verify availability before
# the first store build; these defaults can be overridden in EAS environments.
TIRKHA_ANDROID_PACKAGE=com.tirkha.app
TIRKHA_IOS_BUNDLE_ID=com.tirkha.app
