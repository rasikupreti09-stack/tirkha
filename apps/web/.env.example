NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
# Server-only: never use NEXT_PUBLIC_ prefixes for these secrets.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
KHALTI_ENVIRONMENT=sandbox
KHALTI_SECRET_KEY=YOUR_SANDBOX_MERCHANT_SECRET_KEY
ESEWA_ENVIRONMENT=sandbox
ESEWA_PRODUCT_CODE=YOUR_ESEWA_MERCHANT_PRODUCT_CODE
ESEWA_SECRET_KEY=YOUR_ESEWA_MERCHANT_SECRET_KEY
APP_URL=http://localhost:3000

# Optional call relay settings. TURN_USERNAME and TURN_PASSWORD are server-only.
# TURN_PASSWORD is provider-issued TURN credential; TURN_SHARED_SECRET is optional
# for Coturn's REST mode, where the API creates one-hour temporary credentials.
NEXT_PUBLIC_TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
TURN_SHARED_SECRET=

# Optional server-only Google Routes API key for road-snapped routes and ETA.
GOOGLE_MAPS_API_KEY=

# Server-only notification worker authentication; use a random secret >=32 characters.
PUSH_DISPATCH_SECRET=
# Optional: required if Expo enhanced push security is enabled.
EXPO_ACCESS_TOKEN=

# Optional server-only reverse geocoder overrides; both apps use this server.
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=Tirkha/0.1 (Nepal service booking)

# Optional server-only visual symptom triage. Images are processed transiently and not stored by Tirkha.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Server-only transaction cold-archive bridge. Never use NEXT_PUBLIC_* for these.
FINANCE_ARCHIVE_URL=https://YOUR_SECURE_ARCHIVE_RECEIVER.example/api/transactions
FINANCE_ARCHIVE_SECRET=YOUR_ARCHIVE_RECEIVER_BEARER_SECRET
FINANCE_ARCHIVE_CRON_SECRET=YOUR_RANDOM_CRON_BEARER_SECRET
